# 复制为 .env 后填写。不填 LLM 也能跑，只是没有中文摘要，AI 相关性退化为关键词判断。

# LLM（tokhive）。地址要带到 /v1 这一层，例如 https://example.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# openai = /chat/completions；anthropic = /messages
LLM_API_FORMAT=openai

# 可选：GitHub token，提高搜索接口额度
GITHUB_TOKEN=

# 可选
PORT=8787
REPORT_TZ=Asia/Shanghai
DB_PATH=data/ai.db
